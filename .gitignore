node_modules/
clients/ts/**/dist/
clients/ts/.dev/
clients/ts/dev-server.toml
# What `run_demo.sh` is actually serving right now — a fact about an invocation, not about the
# repository, and the reason the demo no longer rewrites a tracked file to record it.
clients/ts/viewer/public/datasets.json
# Where `publish-clusters.mjs` put the clusters it published into *this* server's WAL. Layers live
# in the WAL rather than the bundle, so the names in it mean nothing to another server — and the
# script is re-run per server anyway, a layer name never being reusable.
clients/ts/viewer/public/clusters.json
*.env.local
