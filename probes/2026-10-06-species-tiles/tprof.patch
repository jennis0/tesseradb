diff --git a/crates/tessera-engine/src/tprof.rs b/crates/tessera-engine/src/tprof.rs
new file mode 100644
index 00000000..e1e3ca71
--- /dev/null
+++ b/crates/tessera-engine/src/tprof.rs
@@ -0,0 +1,50 @@
+//! TEMPORARY per-phase counters for the species-tiles diagnosis. Remove before merge.
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::time::Instant;
+
+pub const SLOTS: usize = 4; // levels 0..2, slot 3 = per-tile / per-request, level-agnostic
+pub const NAMES: &[&str] = &[
+    "ns_setup", "ns_overlap", "n_cand", "ns_heap", "n_heap", "ns_admitted", "n_admitted_calls",
+    "n_popped", "ns_presence", "n_probes", "n_probe_hits", "n_scans", "ns_scan", "ns_bits",
+    "ns_assemble", "n_chosen", "n_tile_levels", "ns_tile_sets", "ns_pre", "ns_settle", "ns_frame",
+    "ns_total", "n_tiles", "n_overlap_raw", "n_window", "ns_scan_rows", "ns_level_pass",
+    "n_scan_rows", "n_admit_new", "ns_admit_new",
+];
+pub const N: usize = 30;
+#[allow(clippy::declare_interior_mutable_const)]
+const Z: AtomicU64 = AtomicU64::new(0);
+#[allow(clippy::declare_interior_mutable_const)]
+const ROW: [AtomicU64; N] = [Z; N];
+pub static P: [[AtomicU64; N]; SLOTS] = [ROW; SLOTS];
+
+pub fn idx(name: &str) -> usize {
+    NAMES.iter().position(|n| *n == name).expect("a counter name")
+}
+pub fn add(slot: usize, name: &str, v: u64) {
+    P[slot.min(SLOTS - 1)][idx(name)].fetch_add(v, Relaxed);
+}
+pub fn since(slot: usize, name: &str, t: Instant) {
+    add(slot, name, t.elapsed().as_nanos() as u64);
+}
+pub fn dump() {
+    let mut s = String::from("TPROF");
+    for (slot, row) in P.iter().enumerate() {
+        s.push_str(&format!(" | s{slot}"));
+        for (i, c) in row.iter().enumerate() {
+            let v = c.swap(0, Relaxed);
+            if v != 0 {
+                s.push_str(&format!(" {}={}", NAMES[i], v));
+            }
+        }
+    }
+    eprintln!("{s}");
+}
+thread_local! {
+    pub static CUR: std::cell::Cell<usize> = const { std::cell::Cell::new(3) };
+}
+pub fn cur() -> usize {
+    CUR.with(|c| c.get())
+}
+pub fn set_cur(slot: usize) {
+    CUR.with(|c| c.set(slot.min(SLOTS - 1)));
+}
