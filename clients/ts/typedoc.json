{
  "$schema": "https://typedoc-plugin-markdown.org/schema.json",
  "entryPoints": [
    "core/src/index.ts",
    "deck/src/index.ts",
    "components/src/index.ts",
    "react/src/index.ts",
    "react/src/components.ts"
  ],
  "tsconfig": "typedoc.tsconfig.json",
  "plugin": [
    "typedoc-plugin-markdown"
  ],
  "out": "../../docs/reference/typescript",
  "router": "module",
  "readme": "none",
  "entryFileName": "index.md",
  "excludeScopesInPaths": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "excludeCategories": [
    "Elements"
  ],
  "disableSources": true,
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "categorizeByGroup": false,
  "parametersFormat": "table",
  "interfacePropertiesFormat": "table",
  "classPropertiesFormat": "table",
  "typeDeclarationFormat": "table",
  "propertyMembersFormat": "table",
  "enumMembersFormat": "table",
  "indexFormat": "table",
  "blockTags": [
    "@defaultValue",
    "@deprecated",
    "@example",
    "@jsx",
    "@param",
    "@privateRemarks",
    "@remarks",
    "@returns",
    "@see",
    "@throws",
    "@typeParam",
    "@author",
    "@callback",
    "@category",
    "@categoryDescription",
    "@default",
    "@document",
    "@extends",
    "@augments",
    "@yields",
    "@group",
    "@groupDescription",
    "@import",
    "@inheritDoc",
    "@license",
    "@module",
    "@mergeModuleWith",
    "@prop",
    "@property",
    "@return",
    "@satisfies",
    "@since",
    "@sortStrategy",
    "@template",
    "@this",
    "@type",
    "@typedef",
    "@summary",
    "@preventInline",
    "@inlineType",
    "@preventExpand",
    "@expandType",
    "@tagname",
    "@attr",
    "@fires",
    "@slot",
    "@csspart",
    "@cssprop",
    "@cssproperty"
  ],
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "logLevel": "Warn",
  "typeAliasPropertiesFormat": "table",
  "notRenderedTags": [
    "@showCategories",
    "@showGroups",
    "@hideCategories",
    "@hideGroups",
    "@disableGroups",
    "@expand",
    "@preventExpand",
    "@expandType",
    "@summary",
    "@group",
    "@groupDescription",
    "@category",
    "@categoryDescription",
    "@tagname",
    "@attr",
    "@fires",
    "@slot",
    "@csspart",
    "@cssprop",
    "@cssproperty",
    "@prop",
    "@property"
  ],
  "categoryOrder": [
    "Store",
    "Projections",
    "Counts",
    "Filters",
    "Layers and views",
    "Coordinates and colour",
    "HTTP client",
    "Control plane",
    "Meta",
    "Requests and responses",
    "*"
  ],
  "treatWarningsAsErrors": true,
  "useHTMLAnchors": true
}
