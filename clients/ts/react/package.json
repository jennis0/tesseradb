{
  "name": "@mosaicajs/react",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "React hooks over the headless store, and typed wrappers for the mosaica-* elements behind a separate entry.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "mosaica-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components": {
      "mosaica-source": "./src/components.ts",
      "types": "./dist/components.d.ts",
      "default": "./dist/components.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ../scripts/build-package.mjs",
    "prepack": "node ../scripts/pack.mjs before",
    "postpack": "node ../scripts/pack.mjs after",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mosaicajs/client": "^0.1.0"
  },
  "peerDependencies": {
    "@lit/react": "^1.0.0",
    "@mosaicajs/components": "^0.1.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@lit/react": {
      "optional": true
    },
    "@mosaicajs/components": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lit/react": "^1.0.8",
    "@mosaicajs/components": "^0.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "happy-dom": "^20.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
