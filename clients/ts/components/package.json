{
  "name": "@tesseradb/components",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "tessera-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./store": {
      "tessera-source": "./src/store-element.ts",
      "types": "./dist/store-element.d.ts",
      "default": "./dist/store-element.js"
    },
    "./map": {
      "tessera-source": "./src/map.ts",
      "types": "./dist/map.d.ts",
      "default": "./dist/map.js"
    },
    "./status": {
      "tessera-source": "./src/status.ts",
      "types": "./dist/status.d.ts",
      "default": "./dist/status.js"
    },
    "./count": {
      "tessera-source": "./src/count.ts",
      "types": "./dist/count.d.ts",
      "default": "./dist/count.js"
    },
    "./item-card": {
      "tessera-source": "./src/item-card.ts",
      "types": "./dist/item-card.d.ts",
      "default": "./dist/item-card.js"
    },
    "./filter": {
      "tessera-source": "./src/filter.ts",
      "types": "./dist/filter.d.ts",
      "default": "./dist/filter.js"
    },
    "./filter-panel": {
      "tessera-source": "./src/filter-panel.ts",
      "types": "./dist/filter-panel.d.ts",
      "default": "./dist/filter-panel.js"
    },
    "./selection": {
      "tessera-source": "./src/selection.ts",
      "types": "./dist/selection.d.ts",
      "default": "./dist/selection.js"
    },
    "./layer-picker": {
      "tessera-source": "./src/layer-picker.ts",
      "types": "./dist/layer-picker.d.ts",
      "default": "./dist/layer-picker.js"
    },
    "./view-picker": {
      "tessera-source": "./src/view-picker.ts",
      "types": "./dist/view-picker.d.ts",
      "default": "./dist/view-picker.js"
    },
    "./key-picker": {
      "tessera-source": "./src/key-picker.ts",
      "types": "./dist/key-picker.d.ts",
      "default": "./dist/key-picker.js"
    },
    "./artifact-list": {
      "tessera-source": "./src/artifact-list.ts",
      "types": "./dist/artifact-list.d.ts",
      "default": "./dist/artifact-list.js"
    },
    "./artifact-card": {
      "tessera-source": "./src/artifact-card.ts",
      "types": "./dist/artifact-card.d.ts",
      "default": "./dist/artifact-card.js"
    },
    "./hierarchy": {
      "tessera-source": "./src/hierarchy.ts",
      "types": "./dist/hierarchy.d.ts",
      "default": "./dist/hierarchy.js"
    },
    "./legend": {
      "tessera-source": "./src/legend.ts",
      "types": "./dist/legend.d.ts",
      "default": "./dist/legend.js"
    },
    "./explorer": {
      "tessera-source": "./src/explorer.ts",
      "types": "./dist/explorer.d.ts",
      "default": "./dist/explorer.js"
    },
    "./tessera-components.js": "./dist/tessera-components.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../scripts/build-package.mjs && npm run bundle",
    "prepack": "node ../scripts/pack.mjs before",
    "postpack": "node ../scripts/pack.mjs after",
    "bundle": "vite build && node scripts/sri.mjs",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lit/context": "^1.1.0",
    "@tesseradb/client": "^0.1.0",
    "@tesseradb/deck": "0.1.0"
  },
  "peerDependencies": {
    "@deck.gl/core": "^9.3.7",
    "@deck.gl/layers": "^9.3.7",
    "@luma.gl/core": "^9.3.6",
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@deck.gl/core": "^9.3.7",
    "@deck.gl/layers": "^9.3.7",
    "@luma.gl/core": "^9.3.6",
    "happy-dom": "^20.0.0",
    "lit": "^3.3.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "vitest": "^3.2.0",
    "esbuild": "^0.28.0"
  }
}
